<file path="src/templates/monster.html">
<!--
  Template du composant Monster : UNE ligne de tableau (une créature).
  Structure identique au gabarit fourni. Les valeurs sont vides : elles sont
  remplies par Monster.render() à partir des propriétés de l'objet.
  Ajouts par rapport au gabarit : uniquement des classes "view-*" pour que le JS
  retrouve facilement les <span> d'affichage.
  Ce fichier est un <tr> : il est chargé dans un élément <template> par Monster.js
  (un <tr> ne peut pas être créé directement hors d'un <table>).
-->
<tr class="monster-row">
  <td class="p-3 font-semibold">
    <span class="view-name isEditing-hidden"></span>
    <input type="text" class="input-name isEditing-visible field" />
  </td>
  <td class="p-3">
    <span class="view-type isEditing-hidden"></span>
    <select class="input-type isEditing-visible field">
      <option>Giant reptile</option>
      <option>Alien</option>
      <option>Mutant</option>
      <option>Giant insect</option>
      <option>Robot</option>
      <option>Deep-sea creature</option>
    </select>
  </td>
  <td class="p-3 whitespace-nowrap">
    <span class="view-danger isEditing-hidden"></span>
    <input type="number" min="1" max="5" class="input-danger isEditing-visible field" />
  </td>
  <td class="p-3">
    <span class="view-year isEditing-hidden"></span>
    <input type="number" min="1950" max="1969" class="input-year isEditing-visible field" />
  </td>
  <td class="p-3">
    <div class="flex justify-end gap-2">
      <button class="btn-check isEditing-visible btn btn-jade py-2 px-3" aria-label="Save">
        <i class="fa-solid fa-check"></i>
      </button>
      <button class="btn-edit isEditing-hidden btn btn-gold py-2 px-3" aria-label="Edit">
        <i class="fa-solid fa-pen-to-square"></i>
      </button>
      <button class="btn-delete isEditing-hidden btn btn-lipstick py-2 px-3" aria-label="Delete">
